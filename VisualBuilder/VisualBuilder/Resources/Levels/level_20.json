{
  "id": 20,
  "name": "Build a City",
  "description": "The ultimate challenge! Construct a magnificent city with skyscrapers, a bridge, parks, transit, offices, and iconic landmarks",
  "challengeTime": 35,
  "gridSize": { "width": 10, "height": 8 },
  "backgroundTheme": "skyline_sunset",

  "narrationScripts": {
    "intros": [
      {
        "text": "In a world where only the greatest builders survive... one child stands at the edge of destiny. Fourteen pieces. Thirty-five seconds. One city to rule them all. THIS... is the FINAL LEVEL!",
        "voiceStyle": "epic_movie_trailer",
        "rate": 0.42,
        "pitchMultiplier": 0.78
      },
      {
        "text": "Every level has led to THIS moment. Every house, every rocket, every airport was just practice. Now you face the ultimate test: build an entire CITY from nothing. Skyscrapers that pierce the clouds. A bridge that spans the impossible. You were BORN for this!",
        "voiceStyle": "epic_movie_trailer",
        "rate": 0.40,
        "pitchMultiplier": 0.75
      },
      {
        "text": "The ground trembles. The sky darkens with anticipation. Fourteen monumental pieces await your command. Schools, hospitals, stadiums, towers of glass and steel! Only a TRUE Master Builder can complete this challenge. Are you ready for GREATNESS?!",
        "voiceStyle": "epic_movie_trailer",
        "rate": 0.43,
        "pitchMultiplier": 0.8
      },
      {
        "text": "They said it couldn't be done. They said no builder could construct an entire city in thirty-five seconds. But they never met YOU. Rise, Master Builder! Your city... your LEGEND... begins NOW!",
        "voiceStyle": "epic_movie_trailer",
        "rate": 0.41,
        "pitchMultiplier": 0.76
      }
    ],
    "progress": {
      "25": ["The foundations of greatness are being laid! The city rises!", "A quarter of your destiny is complete! The skyline begins to glow!"],
      "50": ["HALFWAY TO GLORY! The city is alive with steel and stone!", "The bridge connects, the towers climb! You are UNSTOPPABLE!"],
      "75": ["The city is ALMOST COMPLETE! The world watches in awe!", "Three quarters done! Legends are being written about your speed!"],
      "100": ["THE CITY IS COMPLETE! Fireworks light the sky! Trumpets sound! You are the ULTIMATE MASTER BUILDER! Every level, every challenge has led to this TRIUMPH!", "MAGNIFICENT! SPECTACULAR! EXTRAORDINARY! You have built a CITY! The greatest achievement in the history of building! Take a bow, Master Builder. You have CONQUERED the Visual Builder!"]
    },
    "tension": {
      "50": ["Half the time has fallen like sand through an hourglass! Build FASTER!", "The clock is your enemy! Seventeen seconds and a city to finish! GO!"],
      "25": ["TIME IS CRUMBLING! The city needs its hero! PLACE THOSE PIECES!", "This is your FINAL STAND! Eight seconds! The city MUST rise!"],
      "10": ["TEN SECONDS TO DESTINY! Every moment counts! BUILD! BUILD! BUILD!", "The FINAL COUNTDOWN! The whole world holds its breath!"],
      "expired": ["The sun sets on an unfinished city. But even the greatest builders sometimes need a second chance. Rise again, challenger!", "Time has run out on this chapter... but your story is NOT over. Return, and claim your rightful place as Master Builder!"]
    }
  },

