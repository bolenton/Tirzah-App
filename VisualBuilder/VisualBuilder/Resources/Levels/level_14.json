  "backgroundTheme": "industrial_vintage",

  "narrationScripts": {
    "intros": [
      {
        "text": "All aboard! Welcome to Platform Builder, where YOU are the chief engineer! Lay those tracks, raise that clock tower, and get this station shipshape before the express arrives!",
        "voiceStyle": "train_conductor",
        "rate": 0.5,
        "pitchMultiplier": 1.0
      },
      {
        "text": "Tickets, please! Oh wait, we don't have a station yet. That's where you come in, engineer! Build us a station so fine that even the trains will whistle with joy!",
        "voiceStyle": "train_conductor",
        "rate": 0.48,
        "pitchMultiplier": 1.05
      },
      {
        "text": "The 3 o'clock express is on its way, and we haven't got a station! Quick, builder, lay the tracks, set up the platform, and make it grand!",
        "voiceStyle": "train_conductor",
        "rate": 0.52,
        "pitchMultiplier": 0.95
      },
      {
        "text": "Choo choo! Every great journey starts at a great station. Tracks, a platform, a ticket booth... let's build a station that makes travelers smile!",
        "voiceStyle": "train_conductor",
        "rate": 0.46,
        "pitchMultiplier": 1.02
      }
    ],
    "progress": {
      "25": [
        "The tracks are going down! Next stop: progress!",
        "Great work, engineer! The foundation is laid!"
      ],
      "50": [
        "Halfway there! I can almost hear the train whistle!",
        "The platform is taking shape! Keep building, engineer!"
      ],
      "75": [
        "Nearly ready for passengers! Just a few more pieces!",
        "The clock tower is almost up! Finish strong, builder!"
      ],
      "100": [
        "ALL ABOARD! What a magnificent station! The express will be proud!",
        "The station is complete! First train departing NOW! Choo choo!"
      ]
    },
    "tension": {
      "50": [
        "Half the time has passed. The train waits for no one!",
        "The schedule is tight, engineer! Keep those pieces moving!"
      ],
      "25": [
        "The express is approaching! Hurry, builder!",
        "Quarter time remaining! The passengers are getting restless!"
      ],
      "10": [
        "The train is pulling in! Finish the station NOW!",
        "Last call! Seconds left to complete the station!"
      ],
      "expired": [
        "The train has left without a station. How embarrassing! Try again, engineer.",
        "Time's up! The passengers had to wait in the rain. Let's try once more!"
      ]
    }
  },

