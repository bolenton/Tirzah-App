{
  "id": 11,
  "name": "Build a Library",
  "description": "Stack the shelves, set up the desk, and create a quiet reading paradise",
  "challengeTime": 65,
  "gridSize": { "width": 8, "height": 6 },
  "backgroundTheme": "indoor_cozy",

  "narrationScripts": {
    "intros": [
      {
        "text": "Shhh... welcome to the quietest challenge yet. Can you build a library so perfect that even the books will be impressed? Place the shelves, the desk, and every piece with care.",
        "voiceStyle": "whispering_librarian",
        "rate": 0.42,
        "pitchMultiplier": 0.9
      },
      {
        "text": "A world of stories awaits, but first we need somewhere to keep them all. Build this library shelf by shelf, and do try to keep the noise down.",
        "voiceStyle": "whispering_librarian",
        "rate": 0.44,
        "pitchMultiplier": 0.92
      },
      {
        "text": "Every great library starts with a single shelf. Today you will build an entire reading room. Quietly now, the readers are watching.",
        "voiceStyle": "whispering_librarian",
        "rate": 0.4,
        "pitchMultiplier": 0.88
      },
      {
        "text": "Books, shelves, a cozy reading lamp... this library won't build itself. But remember the golden rule: no loud noises!",
        "voiceStyle": "whispering_librarian",
        "rate": 0.46,
        "pitchMultiplier": 0.95
      }
    ],
    "progress": {
      "25": [
        "The first shelves are up. Wonderful, keep going.",
        "A good start. The books are eager to find their home."
      ],
      "50": [
        "Halfway there. The library is starting to feel real.",
        "I can almost smell the old pages. Keep building!"
      ],
      "75": [
        "Nearly done. Just a few more touches and readers can move in.",
        "So close! The reading lamp is flickering with anticipation."
      ],
      "100": [
        "Magnificent! This library is open for business. Shhh!",
        "What a beautiful reading room! The books are delighted!"
      ]
    },
    "tension": {
      "50": [
        "Half the time has passed. Keep shelving quietly.",
        "The clock ticks on. Don't rush, but don't dawdle either."
      ],
      "25": [
        "Time is running low. The librarian is getting nervous!",
        "Hurry, but quietly! A quarter of your time remains!"
      ],
      "10": [
        "Shhh! Almost out of time! Quick, place those last pieces!",
        "The library is closing soon! Finish up, builder!"
      ],
      "expired": [
        "Oh dear. The library closed before you finished. Try again?",
        "Time's up. The books will have to wait for their shelves."
      ]
    }
  },

