  "id": 17,
  "name": "Build an Aquarium",
  "description": "Create a spectacular aquarium with tanks, a coral reef, a tunnel, and amazing sea creatures",
  "challengeTime": 45,
  "gridSize": { "width": 8, "height": 8 },
  "backgroundTheme": "ocean_depths",

  "narrationScripts": {
    "intros": [
      {
        "text": "Diving deep, explorer! We're building an aquarium that would make the ocean jealous. Giant tanks, glowing jellyfish, and a tunnel where you walk with the fishes above you!",
        "voiceStyle": "deep_sea_diver",
        "rate": 0.44,
        "pitchMultiplier": 0.82
      },
      {
        "text": "Bubbles rising, pressure building! Down here in the deep blue, we need tanks for every creature imaginable. Coral reefs, seahorses, and a jellyfish dome that glows in the dark!",
        "voiceStyle": "deep_sea_diver",
        "rate": 0.46,
        "pitchMultiplier": 0.85
      },
      {
        "text": "Welcome to the deep end, builder! Above the surface they have no idea what we're creating. An aquarium so magnificent, even the fish will line up to get in!",
        "voiceStyle": "deep_sea_diver",
        "rate": 0.45,
        "pitchMultiplier": 0.88
      }
    ],
    "progress": {
      "25": ["The first tanks are filled! The fish are swimming in!", "Bubbles are rising! Great start, diver!"],
      "50": ["Halfway through the deep blue! The aquarium is taking shape!", "The coral reef is glowing! Keep building!"],
      "75": ["Almost ready to open the doors! The creatures are eager!", "The jellyfish are pulsing with excitement!"],
      "100": ["The aquarium is magnificent! Every tank is alive with wonder!", "Splashing success! The ocean would be proud of this aquarium!"]
    },
    "tension": {
      "50": ["The tide is turning! Half your air supply is gone!", "Fish are circling impatiently! Pick up the pace, diver!"],
      "25": ["Oxygen running low! Build those last tanks quickly!", "The sea creatures can't wait much longer!"],
      "10": ["Your air tank is nearly empty! Final pieces, NOW!", "Ten seconds of air left! Finish the aquarium!"],
      "expired": ["You've surfaced without finishing! The fish swim away disappointed.", "Air supply depleted! The aquarium remains incomplete."]
    }
  },

