  "narrationScripts": {
    "intros": [
      {
        "text": "Citizens of Buildsville! As your newly elected mayor, I present to you our grand plan: houses, shops, roads, a lovely park, and yes, even street lights! Let the construction begin!",
        "voiceStyle": "mayor_speech",
        "rate": 0.46,
        "pitchMultiplier": 0.92
      },
      {
        "text": "Order, order! The town council has approved the master plan! We need two fine houses, a shop, a restaurant, roads connecting everything, and cars to drive on them. This town will thrive!",
        "voiceStyle": "mayor_speech",
        "rate": 0.45,
        "pitchMultiplier": 0.9
      },
      {
        "text": "My fellow builders, today we break ground on the finest little town this world has ever seen! From the park to the stop signs, every piece makes this community home!",
        "voiceStyle": "mayor_speech",
        "rate": 0.47,
        "pitchMultiplier": 0.88
      }
    ],
    "progress": {
      "25": ["The first roads are paved! The town is starting!", "Foundations are down! The neighborhood is growing!"],
      "50": ["Halfway to a thriving community! Houses are going up!", "The town square is taking shape! Wonderful progress, mayor!"],
      "75": ["Almost a real town! Just a few more pieces to place!", "The residents are packing their bags to move in!"],
      "100": ["The town is alive! Welcome to the greatest little community ever built!", "Ribbon cut! The town of Buildsville is officially open!"]
    },
    "tension": {
      "50": ["The town meeting is in half the time! Keep building, mayor!", "Citizens are waiting to move in! Half the clock is gone!"],
      "25": ["The moving trucks are arriving! We need this town finished!", "Town deadline approaching fast! Build, build, build!"],
      "10": ["The grand opening is in ten seconds! Place those final pieces!", "The ribbon-cutting ceremony cannot wait! Finish NOW!"],
      "expired": ["The citizens moved to a different town. Maybe next time, mayor.", "Town charter expired! Buildsville will have to wait for another day."]
    }
  },

