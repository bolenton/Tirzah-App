{
  "id": 8,
  "name": "Build a Farm",
  "description": "Build a happy farm with a big red barn, a tractor, fences, and all the critters a farm could need!",
  "challengeTime": 80,
  "gridSize": { "width": 8, "height": 7 },
  "backgroundTheme": "countryside",

  "narrationScripts": {
    "intros": [
      {
        "text": "Well howdy there, partner! We got ourselves some empty land and a whole lotta pieces. Time to build the finest farm this side of the river!",
        "voiceStyle": "country_drawl",
        "rate": 0.45,
        "pitchMultiplier": 0.95
      },
      {
        "text": "Rise and shine, farmer builder! The rooster's crowin' but there ain't no barn for him to sit on. Let's fix that right quick!",
        "voiceStyle": "country_drawl",
        "rate": 0.48,
        "pitchMultiplier": 1.0
      },
      {
        "text": "Yeehaw! You've got a barn, a tractor, some fences, and a whole mess of farm fixins. Put 'em all together and make this land come alive!",
        "voiceStyle": "country_drawl",
        "rate": 0.5,
        "pitchMultiplier": 1.05
      },
      {
        "text": "Welcome to farm country, builder! The cows are mooin', the chickens are cluckin', but they need a home. Get to buildin'!",
        "voiceStyle": "country_drawl",
        "rate": 0.47,
        "pitchMultiplier": 0.9
      }
    ],
    "progress": {
      "25": [
        "That's a fine start! The land is already looking like a real farm!",
        "Good goin'! Keep layin' those pieces down, partner!"
      ],
      "50": [
        "Half the farm is built! The animals are starting to feel right at home!",
        "Lookin' mighty fine! I can practically smell the fresh hay!"
      ],
      "75": [
        "Almost there! Just a few more pieces and this farm'll be complete!",
        "The tractor's runnin' and the barn is almost done. Keep at it!"
      ],
      "100": [
        "Yeehaw! That's the prettiest farm I ever did see! Outstanding work!",
        "The farm is complete! The animals are happy and the crops are growin'!"
      ]
    },
    "tension": {
      "50": [
        "Half the time gone, partner! Better pick up the pace!",
        "The sun's movin' across the sky. Keep buildin'!"
      ],
      "25": [
        "Sundown's comin' fast! Hurry up, farmer!",
        "Time's runnin' short! The animals need their homes!"
      ],
      "10": [
        "Last call, partner! Finish that farm before dark!",
        "The sun's almost set! Quick, get those pieces in place!"
      ],
      "expired": [
        "Aw shucks, the sun went down. Better luck tomorrow, partner.",
        "Time's up! The farm ain't finished but you gave it a good try."
      ]
    }
  },

