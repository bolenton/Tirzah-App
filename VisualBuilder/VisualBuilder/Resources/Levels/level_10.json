{
  "id": 10,
  "name": "Build a Zoo",
  "description": "Build an amazing zoo with animal habitats, a gift shop, and paths for visitors to explore. The animals are waiting!",
  "challengeTime": 70,
  "gridSize": { "width": 8, "height": 8 },
  "backgroundTheme": "wildlife_safari",

  "narrationScripts": {
    "intros": [
      {
        "text": "Jambo, builder! Welcome to the wildest challenge yet! We need a full zoo with habitats for lions, monkeys, birds, and reptiles. The animals are ready, are you?",
        "voiceStyle": "safari_guide",
        "rate": 0.5,
        "pitchMultiplier": 1.1
      },
      {
        "text": "Right then, explorer! The trucks have arrived with all the building materials and the animals are in their travel crates. Let's build them a world-class zoo!",
        "voiceStyle": "safari_guide",
        "rate": 0.48,
        "pitchMultiplier": 1.05
      },
      {
        "text": "Look alive, builder! Lions, monkeys, birds, reptiles, they all need a home. And the visitors need paths, benches, and a gift shop. Can you build it all in time?",
        "voiceStyle": "safari_guide",
        "rate": 0.52,
        "pitchMultiplier": 1.0
      },
      {
        "text": "Welcome to zoo construction, the ultimate building challenge! Ten pieces, one incredible zoo. Place each habitat with care and don't forget the entrance gate!",
        "voiceStyle": "safari_guide",
        "rate": 0.45,
        "pitchMultiplier": 0.95
      }
    ],
    "progress": {
      "25": [
        "Brilliant start! The zoo is beginning to take shape!",
        "The entrance is looking grand! Keep those pieces coming!"
      ],
      "50": [
        "Halfway there! The monkeys are already swinging with excitement!",
        "Fantastic progress! The visitors are lining up outside!"
      ],
      "75": [
        "Almost done! Just a few more habitats to place!",
        "Nearly there! The lions can practically smell their new home!"
      ],
      "100": [
        "The zoo is OPEN! What a magnificent animal kingdom you've built!",
        "Spectacular work, builder! This is the finest zoo in the land!"
      ]
    },
    "tension": {
      "50": [
        "Half your time is gone! The animals are getting restless!",
        "Keep moving, builder! The visitors won't wait forever!"
      ],
      "25": [
        "Time is running out! The gift shop still needs stocking!",
        "Hurry! The animals need their homes before closing time!"
      ],
      "10": [
        "Last seconds! Quick, finish the zoo!",
        "The gates close in moments! Rush those final pieces in!"
      ],
      "expired": [
        "Time's up! The animals will have to camp out tonight. Try again, explorer!",
        "Oh no, closing time! The zoo isn't quite finished. Give it another go!"
      ]
    }
  },

