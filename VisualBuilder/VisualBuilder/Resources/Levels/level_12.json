  "narrationScripts": {
    "intros": [
      {
        "text": "Duuude! Welcome to the chillest build ever. Sun, sand, and surf await. Grab that umbrella and let's make this beach totally epic, bro!",
        "voiceStyle": "surfer_dude",
        "rate": 0.5,
        "pitchMultiplier": 1.05
      },
      {
        "text": "Whoa, rad builder alert! Time to lay down some gnarly waves, plant a sandcastle, and set up the most bodacious beach scene ever!",
        "voiceStyle": "surfer_dude",
        "rate": 0.52,
        "pitchMultiplier": 1.1
      },
      {
        "text": "Surf's up, little dude! Before we catch waves, we gotta build the beach. Towels, umbrellas, the whole shebang. Let's do this!",
        "voiceStyle": "surfer_dude",
        "rate": 0.48,
        "pitchMultiplier": 1.0
      },
      {
        "text": "Nothing beats a perfect beach day, bro. But this beach needs YOUR help. Set up the scene and make it totally tubular!",
        "voiceStyle": "surfer_dude",
        "rate": 0.5,
        "pitchMultiplier": 1.08
      }
    ],
    "progress": {
      "25": [
        "Nice start, bro! The beach is already looking chill.",
        "Radical! Keep laying those pieces down!"
      ],
      "50": [
        "Halfway there, dude! This beach is gonna be epic!",
        "Whoa, looking gnarly! The surf is calling!"
      ],
      "75": [
        "Almost there, bro! Just a few more pieces to paradise!",
        "So close to the perfect beach day! Keep going!"
      ],
      "100": [
        "Cowabunga! That is one totally awesome beach, dude!",
        "Surf's up! You built the most radical beach ever, bro!"
      ]
    },
    "tension": {
      "50": [
        "Half the time is gone, dude. Ride the wave faster!",
        "The tide is coming in, bro! Keep building!"
      ],
      "25": [
        "Whoa, time's getting gnarly! Hurry it up, builder!",
        "The sun's setting fast! Finish this beach, bro!"
      ],
      "10": [
        "Dude! Wipeout incoming! Place those pieces NOW!",
        "Last wave, bro! Quick, finish the beach!"
      ],
      "expired": [
        "Bummer, dude. The tide washed it all away. Try again!",
        "Wipeout! Time ran out. The beach will be here for another try, bro."
      ]
    }
  },

