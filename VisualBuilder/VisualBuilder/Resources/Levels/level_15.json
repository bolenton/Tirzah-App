{
  "id": 15,
  "name": "Build a Space Station",
  "description": "Assemble modules, deploy solar panels, and construct humanity's home among the stars",
  "challengeTime": 50,
  "gridSize": { "width": 8, "height": 8 },
  "backgroundTheme": "deep_space",

  "narrationScripts": {
    "intros": [
      {
        "text": "Houston, we have a builder. Mission: construct the orbital space station. Modules, solar panels, and an observation deck. T-minus now. Let's get to work, astronaut.",
        "voiceStyle": "mission_control",
        "rate": 0.48,
        "pitchMultiplier": 0.95
      },
      {
        "text": "Mission Control to Builder One. You are cleared for construction in low Earth orbit. Assemble the station module by module. The stars are counting on you.",
        "voiceStyle": "mission_control",
        "rate": 0.46,
        "pitchMultiplier": 0.92
      },
      {
        "text": "This is Mission Control. The crew is waiting for their space station, and you are our best engineer. Solar panels, labs, the whole package. Make us proud up there.",
        "voiceStyle": "mission_control",
        "rate": 0.44,
        "pitchMultiplier": 0.9
      },
      {
        "text": "Gravity is optional, but precision is not. Build this space station piece by piece. Each module matters. Each connection counts. Go for launch, builder.",
        "voiceStyle": "mission_control",
        "rate": 0.5,
        "pitchMultiplier": 0.98
      }
    ],
    "progress": {
      "25": [
        "First module is in orbit. Good work, astronaut.",
        "Roger that. Construction is underway. Keep it steady."
      ],
      "50": [
        "Halfway assembled. The station is taking shape against the stars.",
        "Copy that, builder. Looking good from down here!"
      ],
      "75": [
        "Almost operational! Just a few more components to attach!",
        "Station is at 75 percent. We can see it from the ground!"
      ],
      "100": [
        "Mission accomplished! The space station is fully operational! Outstanding work, astronaut!",
        "Houston, the station is complete! What a beautiful sight in orbit!"
      ]
    },
    "tension": {
      "50": [
        "Half your oxygen... I mean time... is gone. Stay focused.",
        "Fifty percent of mission time elapsed. Maintain pace, builder."
      ],
      "25": [
        "Warning: mission time critical. Accelerate construction!",
        "Twenty-five percent remaining. We need that station built, astronaut!"
      ],
      "10": [
        "ALERT! Ten seconds to mission failure! Build, build, BUILD!",
        "Final countdown! Place those last pieces NOW, astronaut!"
      ],
      "expired": [
        "Mission failed. The station drifted into deep space. We'll try again, astronaut.",
        "Time expired. The crew will have to wait. Regroup and relaunch, builder."
      ]
    }
  },

