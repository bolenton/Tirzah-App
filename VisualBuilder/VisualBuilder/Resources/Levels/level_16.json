{
  "id": 16,
  "name": "Build an Airport",
  "description": "Construct a bustling airport with runways, terminals, planes, and a control tower",
  "challengeTime": 50,
  "gridSize": { "width": 9, "height": 7 },
  "backgroundTheme": "tarmac",

  "narrationScripts": {
    "intros": [
      {
        "text": "Good morning, passengers! This is your captain speaking. We have a slight problem... there's no airport! Time to build one from the ground up. Fasten your seatbelts!",
        "voiceStyle": "pilot_captain",
        "rate": 0.45,
        "pitchMultiplier": 0.85
      },
      {
        "text": "Tower to builder, tower to builder. We've got incoming flights and nowhere to land them. We need runways, terminals, the whole operation. You are cleared to construct!",
        "voiceStyle": "pilot_captain",
        "rate": 0.47,
        "pitchMultiplier": 0.9
      },
      {
        "text": "Attention all ground crew! We're building the finest airport this side of the clouds. Two runways, a terminal, gates, and planes ready to soar. Let's get this show off the ground!",
        "voiceStyle": "pilot_captain",
        "rate": 0.48,
        "pitchMultiplier": 0.88
      },
      {
        "text": "Welcome aboard Flight Build-It-One-Six! Our destination: the most amazing airport ever constructed. Estimated build time: as fast as your fingers can fly!",
        "voiceStyle": "pilot_captain",
        "rate": 0.46,
        "pitchMultiplier": 0.92
      }
    ],
    "progress": {
      "25": ["The tarmac is taking shape! Runways are looking good!", "Ground crew reporting: foundation is solid!"],
      "50": ["Halfway there, captain! The terminal is rising!", "We've got a real airport forming here!"],
      "75": ["Almost ready for the first flight! Final pieces incoming!", "The planes are eager to taxi in!"],
      "100": ["Airport is open for business! First flight departing now!", "Beautiful work, captain! Clear skies and smooth landings ahead!"]
    },
    "tension": {
      "50": ["Flights are circling overhead! We need to hurry!", "Half the time gone and planes are waiting to land!"],
      "25": ["Mayday, mayday! Time is running out, builder!", "Passengers are getting restless! Build faster!"],
      "10": ["Final approach! Ten seconds to finish this airport!", "Emergency landing required! Place those last pieces NOW!"],
      "expired": ["All flights diverted! The airport wasn't ready in time!", "Control tower is dark. We'll try again next time, captain."]
    }
  },

