{
  "id": 9,
  "name": "Build a Park",
  "description": "Create a beautiful park with a lake, benches, a bridge, trees, and a splashing fountain for everyone to enjoy!",
  "challengeTime": 75,
  "gridSize": { "width": 8, "height": 7 },
  "backgroundTheme": "nature_park",

  "narrationScripts": {
    "intros": [
      {
        "text": "Hey there, friend. Welcome to the great outdoors. We've got a lovely spot of land here that's just begging to become a park. Take it easy and build something beautiful.",
        "voiceStyle": "relaxed_ranger",
        "rate": 0.45,
        "pitchMultiplier": 0.9
      },
      {
        "text": "What a perfect day to build a park! A little lake here, some benches there, maybe a fountain in the middle. Nature is counting on you, builder.",
        "voiceStyle": "relaxed_ranger",
        "rate": 0.48,
        "pitchMultiplier": 0.95
      },
      {
        "text": "Breathe in that fresh air, builder! Now let's turn this open space into the most relaxing park in town. Trees, a bridge, a duck pond, the works!",
        "voiceStyle": "relaxed_ranger",
        "rate": 0.5,
        "pitchMultiplier": 1.0
      },
      {
        "text": "The birds are singing and the sun is shining. All that's missing is a park! Place each piece with care and create a place where everyone can unwind.",
        "voiceStyle": "relaxed_ranger",
        "rate": 0.47,
        "pitchMultiplier": 1.05
      }
    ],
    "progress": {
      "25": [
        "Nice start! The park is beginning to take shape.",
        "Looking good! The birds are already scouting for nesting spots."
      ],
      "50": [
        "Halfway there! I can almost hear the fountain splashing!",
        "Beautiful work so far! The park is coming to life."
      ],
      "75": [
        "Almost done! Just a few more pieces to place!",
        "So close! The ducks are lining up at the pond already!"
      ],
      "100": [
        "What a stunning park! The whole town will love this place!",
        "Park complete! Time to sit on a bench and enjoy your creation!"
      ]
    },
    "tension": {
      "50": [
        "Half the time has drifted by, like clouds across the sky. Keep going!",
        "Still plenty of time, but don't dawdle too long!"
      ],
      "25": [
        "The sun is getting low! Better hurry, builder!",
        "Time's running short! The park visitors are waiting!"
      ],
      "10": [
        "Almost out of time! Quick, place those last pieces!",
        "The gates close in seconds! Finish that park!"
      ],
      "expired": [
        "Time's up. The park will have to wait for another day.",
        "Oh, the sun set before you could finish. A peaceful try, though!"
      ]
    }
  },

