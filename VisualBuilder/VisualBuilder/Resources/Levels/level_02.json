  "narrationScripts": {
    "intros": [
      {
        "text": "Time to cook up something special! Build a kitchen from scratch. We need a fridge, a stove, a sink, and all the counters!",
        "voiceStyle": "warm_chef",
        "rate": 0.48,
        "pitchMultiplier": 1.0
      },
      {
        "text": "What's cooking, builder? Nothing yet! Because we don't have a kitchen! Let's fix that, shall we?",
        "voiceStyle": "warm_chef",
        "rate": 0.5,
        "pitchMultiplier": 1.1
      },
      {
        "text": "Every great meal starts with a great kitchen. Place each appliance carefully. A chef is only as good as their workspace!",
        "voiceStyle": "wise_narrator",
        "rate": 0.47,
        "pitchMultiplier": 0.95
      }
    ],
    "progress": {
      "25": ["The kitchen is starting to come together!", "First appliance in! Keep going!"],
      "50": ["Halfway there! This kitchen is looking great!", "The counters are filling up nicely!"],
      "75": ["Almost ready to cook! Just a few more pieces!", "Looking delicious! I mean, the kitchen!"],
      "100": ["Chef's kiss! What a beautiful kitchen!", "Bon appetit! The kitchen is complete!"]
    },
    "tension": {
      "50": ["The timer's ticking! Better hurry, chef!", "Half the time gone, keep placing!"],
      "25": ["Order up! You're running low on time!", "The kitchen rush is on! Faster!"],
      "10": ["Last call, chef! Seconds left!", "Almost out of time! Place those pieces!"],
      "expired": ["Kitchen closed! Time ran out!", "Service is over. The timer wins this round!"]
    }
  },

