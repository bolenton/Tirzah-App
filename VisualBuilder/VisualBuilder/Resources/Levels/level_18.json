{
  "id": 18,
  "name": "Build a Spaceship",
  "description": "Assemble a mighty spaceship with hull, wings, engines, cockpit, and everything needed for interstellar travel",
  "challengeTime": 45,
  "gridSize": { "width": 9, "height": 7 },
  "backgroundTheme": "outer_space",

  "narrationScripts": {
    "intros": [
      {
        "text": "T-minus forty-five seconds and counting! Mission Control needs a spaceship, and you're the engineer. Hull, wings, engines, cockpit. Every piece is critical. This is not a drill!",
        "voiceStyle": "nasa_countdown",
        "rate": 0.46,
        "pitchMultiplier": 0.88
      },
      {
        "text": "Houston, we have a... spaceship to build! The launch window is closing fast. Assemble the hull, attach the wings, mount those engines, and don't forget the antenna or we'll lose contact!",
        "voiceStyle": "nasa_countdown",
        "rate": 0.47,
        "pitchMultiplier": 0.85
      },
      {
        "text": "All systems are GO for assembly! The stars are waiting, astronaut. Build this ship piece by piece and prepare for the greatest journey ever launched from a living room!",
        "voiceStyle": "nasa_countdown",
        "rate": 0.45,
        "pitchMultiplier": 0.9
      },
      {
        "text": "Attention flight crew! We need a spacecraft assembled before the launch window closes. Cockpit, hull, wings, engines, fuel, cargo. Every bolt matters when you're going to space!",
        "voiceStyle": "nasa_countdown",
        "rate": 0.44,
        "pitchMultiplier": 0.87
      }
    ],
    "progress": {
      "25": ["Hull integrity at twenty-five percent! Keep building, engineer!", "The skeleton of the ship is forming. Looking good!"],
      "50": ["We are halfway to launch! The ship is taking shape!", "Engines are being mounted! This bird is going to fly!"],
      "75": ["Almost flight-ready! Final components going in!", "The stars are within reach! A few more pieces!"],
      "100": ["All systems nominal! The spaceship is complete! Prepare for launch!", "Mission accomplished! That is one beautiful spacecraft, astronaut!"]
    },
    "tension": {
      "50": ["The launch window is half closed! Build faster, engineer!", "Mission Control is getting nervous! Half the time is gone!"],
      "25": ["Warning! Twenty-five percent fuel window remaining!", "The countdown is accelerating! Hurry, astronaut!"],
      "10": ["T-minus ten! This is it! Place those final pieces!", "Critical time remaining! The rocket must launch NOW!"],
      "expired": ["Launch window closed. Mission scrubbed. We'll try again tomorrow.", "Houston, we have a problem... the ship wasn't ready in time."]
    }
  },

