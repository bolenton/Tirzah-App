{
  "id": 6,
  "name": "Build a Fire Station",
  "description": "Build a fire station with a truck, ladder, and all the gear heroes need to save the day!",
  "challengeTime": 90,
  "gridSize": { "width": 7, "height": 6 },
  "backgroundTheme": "city_emergency",

  "narrationScripts": {
    "intros": [
      {
        "text": "Attention all units! We need a fire station built on the double! Get that building up, park the truck, and hang the ladder. Lives depend on it, builder!",
        "voiceStyle": "urgent_dispatcher",
        "rate": 0.52,
        "pitchMultiplier": 1.1
      },
      {
        "text": "Dispatch calling! We've got a brand new fire crew but nowhere to park the truck. Can you build them a station before the next call comes in?",
        "voiceStyle": "urgent_dispatcher",
        "rate": 0.5,
        "pitchMultiplier": 1.05
      },
      {
        "text": "All hands on deck, builder! This town needs a fire station and you're the one to build it. Truck bay, alarm bell, the whole works. Let's move!",
        "voiceStyle": "urgent_dispatcher",
        "rate": 0.48,
        "pitchMultiplier": 1.0
      },
      {
        "text": "Code red, code red! No fire station in this neighborhood! Quick, grab those pieces and build the bravest station this town has ever seen!",
        "voiceStyle": "urgent_dispatcher",
        "rate": 0.53,
        "pitchMultiplier": 1.15
      }
    ],
    "progress": {
      "25": [
        "First pieces in place! The station is taking shape, keep going!",
        "Good work, recruit! The foundation looks solid!"
      ],
      "50": [
        "Halfway there! The crew is getting excited to move in!",
        "Looking great! I can already picture the truck pulling out!"
      ],
      "75": [
        "Almost finished! Just a few more pieces and we're ready to respond!",
        "Nearly done! The firefighters are suiting up already!"
      ],
      "100": [
        "Station complete! The bravest firehouse in town, thanks to you!",
        "All units, the new fire station is open for business! Outstanding work!"
      ]
    },
    "tension": {
      "50": [
        "Half the time gone, builder! Keep those pieces moving!",
        "Clock's ticking! The fire crew needs their station!"
      ],
      "25": [
        "Time is running out! Faster, faster, builder!",
        "Only a quarter of the time left! Pick up the pace!"
      ],
      "10": [
        "Emergency! Almost out of time! Hurry!",
        "Ten seconds! Drop everything and finish that station!"
      ],
      "expired": [
        "Time's up! The crew will have to wait a bit longer.",
        "Dispatch signing off. We ran out of time, but don't give up!"
      ]
    }
  },

