{
  "id": 13,
  "name": "Build a Castle",
  "description": "Raise the towers, lower the drawbridge, and construct a fortress fit for a king... or a villain",
  "challengeTime": 55,
  "gridSize": { "width": 8, "height": 8 },
  "backgroundTheme": "dark_medieval",

  "narrationScripts": {
    "intros": [
      {
        "text": "Mwahaha! Welcome to MY castle, foolish builder. You think you can construct a fortress worthy of a true villain? Towers, walls, a moat... let's see if you have what it takes!",
        "voiceStyle": "spooky_villain",
        "rate": 0.46,
        "pitchMultiplier": 0.85
      },
      {
        "text": "Thunder crashes in the distance. A dark castle needs a dark builder. Place the stones, raise the towers, and don't forget my throne room. Every villain needs a good throne!",
        "voiceStyle": "spooky_villain",
        "rate": 0.44,
        "pitchMultiplier": 0.8
      },
      {
        "text": "So, you dare to build in MY domain? Very well. Construct this castle perfectly, and perhaps I won't feed you to the moat monster. Perhaps.",
        "voiceStyle": "spooky_villain",
        "rate": 0.42,
        "pitchMultiplier": 0.82
      },
      {
        "text": "Bats flutter overhead as you approach the building site. A castle must rise here, dark and imposing. Towers to the sky, walls of stone, and a drawbridge to keep the heroes OUT!",
        "voiceStyle": "spooky_villain",
        "rate": 0.48,
        "pitchMultiplier": 0.88
      }
    ],
    "progress": {
      "25": [
        "The foundation trembles with dark energy. Keep building!",
        "Yes, yes... the walls begin to rise. Excellent!"
      ],
      "50": [
        "Halfway done! The castle grows more menacing by the minute!",
        "Mwahaha! Even I am impressed. Continue, builder!"
      ],
      "75": [
        "Almost complete! The towers are reaching for the stormy sky!",
        "The moat is filling. The flags are flying. Just a bit more!"
      ],
      "100": [
        "MAGNIFICENT! A castle worthy of the greatest villain! That's me, of course.",
        "The castle stands! Dark, imposing, and absolutely perfect. Well done, minion!"
      ]
    },
    "tension": {
      "50": [
        "Half the time gone. The storm grows closer, builder!",
        "Tick tock, the dungeon clock is counting down!"
      ],
      "25": [
        "The drawbridge is rising! Hurry before you're locked out!",
        "My patience grows thin, builder! A quarter of time remains!"
      ],
      "10": [
        "The ghost army approaches! Build faster! FASTER!",
        "Seconds away from doom! Place those final pieces!"
      ],
      "expired": [
        "FOOL! You failed to complete MY castle! The moat monster is disappointed.",
        "Time has expired. The castle crumbles to dust. How... villainously tragic."
      ]
    }
  },

