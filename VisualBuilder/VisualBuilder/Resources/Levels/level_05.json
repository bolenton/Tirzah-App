{
  "id": 5,
  "name": "Build a School",
  "description": "Construct a school with a building, windows, a flag, and a bus",
  "challengeTime": 95,
  "gridSize": { "width": 8, "height": 6 },
  "backgroundTheme": "campus",

  "narrationScripts": {
    "intros": [
      {
        "text": "School's in session! But first, we need to build it. A strong building, bright windows, a proud flag, and don't forget the school bus!",
        "voiceStyle": "wise_teacher",
        "rate": 0.47,
        "pitchMultiplier": 0.95
      },
      {
        "text": "Attention, class! Today's lesson is in architecture. You'll be constructing an entire school. Every window, every wall matters. Begin!",
        "voiceStyle": "wise_teacher",
        "rate": 0.45,
        "pitchMultiplier": 0.9
      },
      {
        "text": "Learning never stops, and neither does building! Piece by piece, let's create a school that any student would be proud to attend!",
        "voiceStyle": "friendly_narrator",
        "rate": 0.5,
        "pitchMultiplier": 1.0
      }
    ],
    "progress": {
      "25": ["The school foundation is laid! Keep building!", "Class is starting to take shape!"],
      "50": ["Halfway there, scholar! The school is rising!", "The building is coming together nicely!"],
      "75": ["Almost ready for the first day! A few more pieces!", "The school bell is almost ready to ring!"],
      "100": ["School's open! What a magnificent building!", "A+ work, builder! The school is complete!"]
    },
    "tension": {
      "50": ["The first day of school is approaching fast!", "Half the time gone! Build like you mean it!"],
      "25": ["The students are arriving! Hurry, builder!", "Almost out of time! The bus is coming!"],
      "10": ["The bell is about to ring! Finish NOW!", "Last seconds! Place those final pieces!"],
      "expired": ["First day cancelled! You ran out of time!", "Homework: try again next time!"]
    }
  },

