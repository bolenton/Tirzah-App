  "narrationScripts": {
    "intros": [
      {
        "text": "Recess time! Let's build the most awesome playground ever! Slides, swings, and a sandbox. The kids are counting on you!",
        "voiceStyle": "excited_kid",
        "rate": 0.52,
        "pitchMultiplier": 1.15
      },
      {
        "text": "Ready, set, BUILD! This playground needs everything. A super tall slide, swings that go really high, and the biggest sandbox you've ever seen!",
        "voiceStyle": "excited_kid",
        "rate": 0.55,
        "pitchMultiplier": 1.1
      },
      {
        "text": "Fun is serious business, builder! Every kid deserves an amazing playground. Place each piece with joy, and let's create some magic!",
        "voiceStyle": "friendly_narrator",
        "rate": 0.48,
        "pitchMultiplier": 1.0
      }
    ],
    "progress": {
      "25": ["The playground is starting! Fun incoming!", "First piece down! This is going to be great!"],
      "50": ["Halfway to fun town! Keep building!", "The kids are getting excited already!"],
      "75": ["Almost ready for recess! Just a bit more!", "So close to playtime! Finish strong!"],
      "100": ["The playground is OPEN! Time to play!", "What an amazing playground! The kids love it!"]
    },
    "tension": {
      "50": ["Recess is half over! Build faster!", "The bell is coming! Keep going!"],
      "25": ["Almost time for class! Hurry up!", "The kids are waiting! Faster, builder!"],
      "10": ["The bell is about to ring! Quick!", "Seconds left! Place those last pieces!"],
      "expired": ["Ring ring! Recess is over! Time ran out!", "Back to class! The playground will have to wait."]
    }
  },

