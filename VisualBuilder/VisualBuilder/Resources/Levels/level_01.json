{
  "id": 1,
  "name": "Build a House",
  "description": "Place the walls, roof, and door to build a cozy house",
  "challengeTime": 120,
  "gridSize": { "width": 6, "height": 6 },
  "backgroundTheme": "suburban",

  "narrationScripts": {
    "intros": [
      {
        "text": "Welcome, builder! Your very first challenge awaits. Can you build the perfect house? Walls, a roof, and a door. Let's see what you've got!",
        "voiceStyle": "friendly_narrator",
        "rate": 0.48,
        "pitchMultiplier": 1.0
      },
      {
        "text": "Ah, a new architect arrives! Show me what kind of house you can build. Start with the walls and work your way up!",
        "voiceStyle": "excited_mentor",
        "rate": 0.5,
        "pitchMultiplier": 1.1
      },
      {
        "text": "Every great builder starts somewhere. Today, you build your first home. Take your time, place each piece carefully, and make it shine!",
        "voiceStyle": "wise_narrator",
        "rate": 0.45,
        "pitchMultiplier": 0.95
      },
      {
        "text": "Home sweet home! But first, you have to build it. Grab those walls, slap on a roof, and don't forget the front door!",
        "voiceStyle": "friendly_narrator",
        "rate": 0.52,
        "pitchMultiplier": 1.05
      }
    ],
    "progress": {
      "25": [
        "Great start! The foundation is looking solid.",
        "You're on your way, builder! Keep it up!"
      ],
      "50": [
        "The house is taking shape! Halfway there!",
        "Looking good! You can already see it coming together."
      ],
      "75": [
        "Almost done! Just a few more pieces to go!",
        "So close! The house is nearly complete!"
      ],
      "100": [
        "Magnificent! You built a beautiful house!",
        "Welcome home! What a wonderful first build!"
      ]
    },
    "tension": {
      "50": [
        "Halfway through the clock. Keep building!",
        "Half your time is gone, but you've got this!"
      ],
      "25": [
        "The clock is ticking, builder! Pick up the pace!",
        "Time is running short! Keep those pieces moving!"
      ],
      "10": [
        "Hurry! Almost out of time!",
        "Quick, quick, quick! Just a few seconds left!"
      ],
      "expired": [
        "Oh no! Time's up! So close though!",
        "The clock ran out. Better luck next time, builder!"
      ]
    }
  },

