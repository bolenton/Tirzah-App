  "narrationScripts": {
    "intros": [
      {
        "text": "Nature calls, builder! Create a beautiful garden. Plant flowers, grow trees, lay a path, and put up a fence. Make it bloom!",
        "voiceStyle": "peaceful_nature",
        "rate": 0.45,
        "pitchMultiplier": 1.0
      },
      {
        "text": "Breathe in that fresh air! Today we're building a garden paradise. Every flower counts, every tree matters. Let's grow something beautiful!",
        "voiceStyle": "relaxed_ranger",
        "rate": 0.47,
        "pitchMultiplier": 0.95
      },
      {
        "text": "Green thumb time! From seeds to splendor, this garden won't build itself. Grab your pieces and let's plant!",
        "voiceStyle": "excited_mentor",
        "rate": 0.5,
        "pitchMultiplier": 1.05
      }
    ],
    "progress": {
      "25": ["The garden is sprouting! Keep planting!", "First seeds are in! This will be beautiful."],
      "50": ["Halfway to paradise! The garden is blooming!", "Looking greener already! Keep going!"],
      "75": ["Almost a full garden! Just a few more pieces!", "Nature is taking shape! Almost done!"],
      "100": ["What a gorgeous garden! The flowers are blooming!", "Eden has nothing on this! Beautiful work!"]
    },
    "tension": {
      "50": ["The seasons are changing! Better hurry, gardener!", "Half the time has wilted away!"],
      "25": ["Winter is coming! Finish planting fast!", "The sun is setting on your time!"],
      "10": ["Quick! Plant those last pieces before frost!", "Seconds left! Every moment counts!"],
      "expired": ["The frost got the garden! Time ran out!", "Season's over! The timer beat you this time."]
    }
  },

