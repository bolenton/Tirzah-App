{
  "id": 7,
  "name": "Build a Hospital",
  "description": "Construct a hospital complete with an ambulance, patient beds, and the big red cross. Heal the world, builder!",
  "challengeTime": 85,
  "gridSize": { "width": 7, "height": 7 },
  "backgroundTheme": "medical_district",

  "narrationScripts": {
    "intros": [
      {
        "text": "Good morning, builder! We have patients arriving and no hospital to treat them in. Can you build one with beds, windows, and that all-important cross sign?",
        "voiceStyle": "caring_doctor",
        "rate": 0.48,
        "pitchMultiplier": 0.95
      },
      {
        "text": "Paging Doctor Builder! The community needs a hospital and you're just the one to construct it. Reception desk, patient beds, the works. Stat!",
        "voiceStyle": "caring_doctor",
        "rate": 0.5,
        "pitchMultiplier": 1.0
      },
      {
        "text": "A hospital is more than a building, it's a place of hope. Let's build one together, piece by piece. Start with the main structure and add all the details!",
        "voiceStyle": "caring_doctor",
        "rate": 0.45,
        "pitchMultiplier": 0.9
      },
      {
        "text": "Attention please! Construction crew needed in the medical district. We need a hospital built before the next ambulance arrives. Ready, builder?",
        "voiceStyle": "caring_doctor",
        "rate": 0.52,
        "pitchMultiplier": 1.05
      }
    ],
    "progress": {
      "25": [
        "The first walls are up! This hospital is going to be wonderful.",
        "Nice work! The foundation is strong and ready for patients."
      ],
      "50": [
        "Halfway there! I can see the reception area taking shape!",
        "Looking great! The ambulance crew is watching with excitement."
      ],
      "75": [
        "Almost done! The beds are nearly ready for their first patients!",
        "Just a few more pieces! The nurses are preparing to move in."
      ],
      "100": [
        "The hospital is open! Patients can rest easy knowing they're in great hands!",
        "What a magnificent hospital! You truly have a healing touch, builder!"
      ]
    },
    "tension": {
      "50": [
        "Half the time has passed. The patients are waiting!",
        "Keep going! There's still time to finish this hospital."
      ],
      "25": [
        "Time is short! The ambulance is almost here!",
        "Hurry, builder! We need this hospital operational!"
      ],
      "10": [
        "Code blue on the clock! Only seconds remaining!",
        "Almost out of time! Place those last pieces, quick!"
      ],
      "expired": [
        "Time's up. The patients will have to wait, but you gave it your best.",
        "The clock ran out. Don't worry, every great doctor learns from setbacks."
      ]
    }
  },

